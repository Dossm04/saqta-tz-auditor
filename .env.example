# Скопируйте этот файл в .env и укажите ключ LLM. Файл .env в git не попадает.
# Без ключа агент работает в офлайн-режиме (детерминированные правила) — отчёт всё равно формируется.

# ── Вариант 1 (рекомендуемый для хакатона): Google Gemini, бесплатный ключ — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# резервные модели при перегрузке/устаревании основной (подставляются автоматически, если не заданы):
# LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview

# ── Вариант 2: любой OpenAI-совместимый провайдер (OpenAI, shai.pro, vLLM…) — переменные LLM_* имеют приоритет
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Claude через OpenAI-совместимый эндпоинт Anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-5-5

# Локальная модель в контуре банка (Ollama) — данные не покидают периметр
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b-instruct
# LLM_MAX_CONCURRENCY=1
# LLM_FALLBACK_MODELS=
# LLM_TIMEOUT=600
# LLM_CALL_BUDGET=900

# ── Дополнительно
# Приватность: маскирование ИИН/БИН/карт/телефонов/e-mail/IBAN/организаций перед облачным LLM (auto = вкл. для нелокальных)
# LLM_PRIVACY=auto
# Максимальная длина документа в одном запросе (символов); длинный документ делится на части
# LLM_MAX_DOC_CHARS=80000
# Если провайдер не поддерживает response_format=json_object
# LLM_JSON_MODE=false
# LLM_TEMPERATURE=0.1
# Устойчивость: параллельность, бюджет ожидания на вызов (с), кэш ответов (.cache/llm)
# LLM_MAX_CONCURRENCY=3
# LLM_CALL_BUDGET=150
# LLM_CACHE=true
