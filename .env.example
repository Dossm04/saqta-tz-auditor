# Любой OpenAI-совместимый провайдер. Без ключа система работает в офлайн-режиме (правила).

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Пример: Google Gemini (бесплатный ключ: aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3-flash-preview

# Пример: локальная модель в контуре банка (Ollama) — данные не покидают периметр
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b-instruct
# LLM_MAX_CONCURRENCY=1

# Приватность: маскирование ИИН/карт/телефонов/e-mail/IBAN перед облачным LLM (auto = вкл. для нелокальных моделей)
# LLM_PRIVACY=auto

# Пример: shai.pro (уточнить base_url и модель на кикоффе)
# LLM_BASE_URL=https://<shai-endpoint>/v1
# LLM_MODEL=<model>

# Пример: Claude через OpenAI-совместимый эндпоинт Anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-5-5

# Если провайдер не поддерживает response_format=json_object
# LLM_JSON_MODE=false
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=180

# Устойчивость: резервные модели при 429/503/404, параллельность, бюджет ожидания на вызов, кэш ответов
# LLM_FALLBACK_MODELS=model-b,model-c
# LLM_MAX_CONCURRENCY=3
# LLM_CALL_BUDGET=150
# LLM_CACHE=true
